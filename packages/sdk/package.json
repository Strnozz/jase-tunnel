{
  "name": "jase-tunnel",
  "version": "0.5.0",
  "license": "Apache-2.0",
  "description": "Collega la LLM locale dei visitatori al tuo servizio web tramite Jase Tunnel: un comando installa manifest, broker e pannello.",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "jase-tunnel": "bin/cli.mjs"
  },
  "exports": {
    "./mcp": {
      "types": "./src/mcp.d.mts",
      "default": "./src/mcp.mjs"
    },
    "./server": {
      "types": "./src/server.d.mts",
      "default": "./src/server.mjs"
    },
    "./node": {
      "types": "./src/node.d.mts",
      "default": "./src/node.mjs"
    },
    "./browser": {
      "types": "./src/browser.d.mts",
      "default": "./src/browser.mjs"
    },
    "./widget": {
      "types": "./src/widget.d.mts",
      "default": "./src/widget.mjs"
    },
    "./react": {
      "types": "./src/react.d.mts",
      "default": "./src/react.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@types/node": "22.19.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/client": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Strnozz/jase-tunnel.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "llm",
    "ollama",
    "lm-studio",
    "local-ai",
    "tools",
    "mcp",
    "jase-tunnel"
  ]
}
